# --- Runtime ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- PostgreSQL (used by docker-compose and DATABASE_URL) ---
POSTGRES_USER=schoolflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schoolflow
DATABASE_URL=postgresql://schoolflow:change-me@localhost:5432/schoolflow

# --- Secrets (>= 32 chars each): openssl rand -base64 48 ---
SESSION_SECRET=replace-me-with-openssl-rand-base64-48-output
AUDIT_HMAC_KEY=replace-me-with-another-openssl-rand-base64-48

# --- Login rate limiting (optional, defaults shown) ---
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
AUTH_LOGIN_WINDOW_SEC=900

# Default currency for new schools: FCFA | EUR | USD | CAD
DEFAULT_CURRENCY=FCFA
